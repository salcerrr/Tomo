# Copiá este archivo como ".env" y ajustá lo que haga falta.
# Si no existe ".env", Tomo usa el valor de abajo (el de docker-compose.yml).
DATABASE_URL=postgresql://tomo:tomo@localhost:5432/tomo

# Clave que firma las sesiones. Opcional: si no la definís, Tomo genera una
# y la guarda en la base. Para generar una: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Poné 1 cuando la app se sirva por HTTPS (cookie de sesión "Secure").
# TOMO_HTTPS=1

# Cuántos proxies hay delante de la app (1 en Render). En tu computadora,
# dejalo sin definir.
# TOMO_PROXY_HOPS=1

# Horas entre actualizaciones automáticas del catálogo (0 las desactiva).
# TOMO_AUTO_REFRESH_HOURS=24

# Emails con permiso de administrador, separados por coma. Si no lo definís,
# lo es la primera cuenta que se creó.
# TOMO_ADMIN_EMAILS=vos@ejemplo.com
